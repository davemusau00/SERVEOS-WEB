{
  "name": "servos",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run help:build && vite build",
    "release:pwa:package": "node scripts/package-pwa-release.mjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "test:api": "node --test --test-concurrency=1 apps/api/tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --config=playwright.production.config.ts",
    "test:browser:api": "playwright test --config=playwright.api.config.ts",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "audit:ui:gate": "node scripts/audit-ui-gate.mjs",
    "help:build": "node scripts/build-help-index.mjs",
    "docs:check": "npm run help:build && node scripts/docs-check.mjs",
    "contracts:check": "node scripts/check-contracts.mjs",
    "architecture:check": "node scripts/check-web-architecture.mjs",
    "verify:fast": "npm run lint && npm run contracts:check && npm run architecture:check && npm run build && npm test",
    "verify:release": "npm run verify:fast && npm run test:api && npm run test:browser:api && npm run test:browser:production && npm run audit:ui:gate && npm run architecture:check && npm run docs:check",
    "verify": "npm run verify:fast && npm run test:browser:production && npm run audit:ui && npm run docs:check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
