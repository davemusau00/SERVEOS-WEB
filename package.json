{
  "name": "servos",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "npm run help:build && vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "audit:ui": "node scripts/audit-ui.mjs",
    "tauri": "tauri",
    "native:dev": "tauri dev",
    "native:build": "tauri build",
    "test:native": "cargo test --locked --manifest-path native-tests/Cargo.toml",
    "test:native:container": "node scripts/test-native-container.mjs",
    "test:desktop": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib",
    "check:desktop": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "test:cloud": "node scripts/test-supabase.mjs",
    "test:cloud:base": "node scripts/test-supabase.mjs",
    "test:cloud:v2": "node scripts/test-supabase.mjs --expansion",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config=playwright.production.config.ts",
    "protocol:check": "node scripts/protocol-check.mjs",
    "audit:ui:gate": "node scripts/audit-ui-gate.mjs",
    "help:build": "node scripts/build-help-index.mjs",
    "docs:check": "npm run help:build && node scripts/docs-check.mjs",
    "verify:source": "node scripts/verify-production.mjs",
    "verify:fast": "npm run lint && npm run build && npm test",
    "verify:release": "npm run verify:fast && npm run test:cloud:base && npm run test:cloud:v2 && npm run test:native && npm run test:desktop && npm run test:browser:production && npm run protocol:check && npm run audit:ui:gate && npm run docs:check",
    "verify": "npm run help:build && npm run verify:fast && npm run test:browser && npm run test:native:container && npm run audit:ui && npm run docs:check"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
