# Example only. Review security/TLS/log policy before production.

serveos.davemusau.co.ke {
    encode zstd gzip
    reverse_proxy web:80
}

serveosapi.davemusau.co.ke {
    encode zstd gzip

    @sse path /v1/sync/stream
    reverse_proxy @sse api:3000 {
        flush_interval -1
    }

    reverse_proxy api:3000
}
