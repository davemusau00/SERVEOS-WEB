SERVEOS_VERSION=local
API_HOST_PORT=3101
POSTGRES_DB=serveos
POSTGRES_USER=serveos
POSTGRES_PASSWORD=replace-with-long-random-alphanumeric-secret
DATABASE_URL=postgresql://serveos:replace-with-long-random-alphanumeric-secret@postgres:5432/serveos
WEB_ORIGIN=https://serveos-staging.davemusau.co.ke
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
DB_POOL_SIZE=10
WORKER_DB_POOL_SIZE=5

# Configure an rclone remote using its RCLONE_CONFIG_<REMOTE>_* variables.
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=AWS
RCLONE_CONFIG_BACKUP_REGION=replace-with-region
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=replace-with-scoped-access-key
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=replace-with-secret
# RCLONE_CONFIG_BACKUP_ENDPOINT=https://s3-compatible-endpoint.example
BACKUP_REMOTE=backup:serveos/database
AGE_RECIPIENT=age1replacewiththebusinessbackuppublicrecipientkey0000000000000000000
