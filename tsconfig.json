{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": [
      "vite/client"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/main.tsx",
    "vite.config.ts",
    "playwright.api.config.ts",
    "playwright.production.config.ts",
    "tests/browser/**/*.ts",
    "tests/browser/**/*.tsx"
  ],
  "exclude": [
    ".playwright-tmp",
    "build",
    "coverage",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results"
  ]
}
