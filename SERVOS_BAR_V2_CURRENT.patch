+        <div className="mt-4 grid grid-cols-2 gap-2"><button className={primaryButtonClass} onClick={()=>void run('order.fire',{orderId:active.id})}><Flame className="mr-1 inline h-4 w-4"/>Fire</button><button className={buttonClass} onClick={()=>setModal({kind:'PAY'})}><CreditCard className="mr-1 inline h-4 w-4"/>Pay</button><button className={buttonClass} onClick={()=>setModal({kind:'SPLIT'})}><Split className="mr-1 inline h-4 w-4"/>Split tender</button><button className={buttonClass} onClick={()=>setModal({kind:'DISCOUNT'})}>Discount</button><button className={buttonClass} onClick={()=>setModal({kind:'MOVE'})}>Transfer / merge</button><button className={buttonClass} onClick={()=>setModal({kind:'VOID'})}><ShieldAlert className="mr-1 inline h-4 w-4"/>Void</button></div>
