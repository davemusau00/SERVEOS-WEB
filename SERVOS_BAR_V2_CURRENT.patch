+import React, { useMemo, useState } from 'react';
+import { useRuntime } from '../runtime/RuntimeProvider';
+import { buttonClass, fieldClass, primaryButtonClass, recordOf, recordsOf } from './records';
+
+const steps = [
+  ['BUSINESS_IDENTITY','Business identity',true],['TAX','Tax configuration',true],['PAYMENTS','Payment methods',true],['SERVICE_AREAS','Service areas',true],
+  ['STOCK_LOCATIONS','Stock locations',true],['CATALOG','Catalog & stock master',true],['RECIPES_PORTIONS','Recipes & portions',false],['OPENING_INVENTORY','Opening inventory',true],
+  ['FLOORPLAN','Tables & floorplan',false],['STAFF_ACCESS','Staff & access',true],['TILL','Till configuration',true],['BACKUP_SYNC','Backup & synchronization',false]
+] as const;
+
+export const SetupWizard = () => {
+  const runtime = useRuntime();
+  const snapshot = runtime.snapshot!;
+  const progress = recordsOf(snapshot, 'businessSetup')[0] || { completedSteps: [] };
+  const done: string[] = progress.completedSteps || [];
+  const [active, setActive] = useState<string>(steps.find(s => !done.includes(s[0]))?.[0] || 'BUSINESS_IDENTITY');
+  const [message, setMessage] = useState('');
+  const complete = async (step: string, nextStep?: string) => { await runtime.command('setup.completeStep', { step, nextStep }); setMessage(`${step.replaceAll('_',' ')} completed.`); };
+  const save = async (collection: string, id: string, data: Record<string, unknown>) => {
+    const existing = recordOf(runtime.snapshot, collection, id);
+    await runtime.command('record.save', { collection, id, data: { ...(existing?.data || {}), ...data } }, existing?.version);
+  };
+  const required = steps.filter(s => s[2]).map(s => s[0]);
+  const ready = required.every(s => done.includes(s));
+  const percent = Math.round(done.filter(s => required.includes(s as any)).length / required.length * 100);
+  const content = (() => {
+    switch (active) {
+      case 'BUSINESS_IDENTITY': return <IdentityStep onSave={async values => { await save('organization','business',values); await save('property','property',{ name: values.name, legalName: values.legalName, phone: values.phone, email: values.email, address: values.address, kraPin: values.kraPin, receiptFooter: values.receiptFooter, currency:'KES', timezone:'Africa/Nairobi' }); await complete(active,'TAX'); }} existing={recordsOf(snapshot,'organization')[0] || {}} />;
+      case 'TAX': return <TaxStep existing={recordsOf(snapshot,'property')[0] || {}} onSave={async values => { await save('property','property',{ taxConfigured:true, pricesIncludeTax:true, ...values }); await complete(active,'PAYMENTS'); }} />;
+      case 'PAYMENTS': return <PaymentStep intake={runtime.status?.intakeProfile} existing={recordsOf(snapshot,'paymentConfig')[0]} onSave={async data => { await save('paymentConfig','main',{ name:'Payments', ...data }); await complete(active,'SERVICE_AREAS'); }} />;
+      case 'SERVICE_AREAS': return <NameListStep title="Service areas" initial={runtime.status?.intakeProfile?.serviceAreas || ['Main Bar']} existing={recordsOf(snapshot,'outlets')} onCreate={async names => { const existingNames=new Set(recordsOf(runtime.snapshot,'outlets').map(x=>String(x.name).trim().toLowerCase())); for (const name of names) if(!existingNames.has(name.toLowerCase())) await save('outlets', crypto.randomUUID(), { name, propertyId:'property', type:'BAR', active:true, defaultStockLocationId:null }); await complete(active,'STOCK_LOCATIONS'); }} />;
+      case 'STOCK_LOCATIONS': return <NameListStep title="Stock locations" initial={runtime.status?.intakeProfile?.stockAreas || ['Main Store','Bar Store']} existing={recordsOf(snapshot,'stockLocations')} onCreate={async names => { const before=recordsOf(runtime.snapshot,'stockLocations'); const existingNames=new Set(before.map(x=>String(x.name).trim().toLowerCase())); const created:string[]=[]; for (const name of names) if(!existingNames.has(name.toLowerCase())) { const id=crypto.randomUUID(); created.push(id); await save('stockLocations',id,{ name, propertyId:'property', type:name.toLowerCase().includes('fridge')?'FRIDGE':'STORE' }); } const first=before[0]?.id || created[0]; if(!first) throw new Error('Create at least one stock location'); for (const outlet of recordsOf(runtime.snapshot,'outlets')) await save('outlets',outlet.id,{ ...outlet, defaultStockLocationId:first }); await complete(active,'CATALOG'); }} />;
+      case 'CATALOG': return <FirstCatalogStep snapshot={snapshot} onSave={async input => { const stockId=crypto.randomUUID(); await save('stockItems',stockId,{ name:input.stockName,code:input.code,baseUnit:input.baseUnit,averageUnitCost:input.cost,currentStock:{} }); const outletIds=recordsOf(runtime.snapshot,'outlets').map(x=>x.id); await save('products',crypto.randomUUID(),{ name:input.productName,code:input.code,price:input.price,category:input.category,routeTo:'BAR',outletIds,stockItemId:stockId,portionVolume:input.portionVolume,taxClassId:'A_STANDARD',favorite:true,barcode:input.barcode,portions:[],modifiers:[],recipeIngredients:[] }); await complete(active,'RECIPES_PORTIONS'); }} products={recordsOf(snapshot,'products')} />;
+      case 'RECIPES_PORTIONS': return <SimpleComplete title="Recipes & portions" description="Detailed portions, recipes, modifiers and mixers are maintained in Catalog Studio. You can configure them now after setup or skip this optional step." onComplete={() => complete(active,'OPENING_INVENTORY')} />;
+      case 'OPENING_INVENTORY': return <OpeningInventoryStep snapshot={snapshot} onPost={async (stockItemId,locationId,quantity) => runtime.command('inventory.openingBalance',{ stockItemId,locationId,quantity,reason:'Opening stock count' })} onComplete={() => complete(active,'FLOORPLAN')} />;
+      case 'FLOORPLAN': return <FloorSetup snapshot={snapshot} suggested={runtime.status?.intakeProfile?.estimatedTables || 0} onSave={async (outletId,count) => { const tables=Array.from({length:count},(_,i)=>({ id:crypto.randomUUID(), label:String(i+1), capacity:4, section:'MAIN', shape:'SQUARE', posX:5+(i%4)*23, posY:10+Math.floor(i/4)*22, minimumSpend:0, isJoinable:true })); await runtime.command('floorplan.save',{ outletId, baseline:[], tables }); await complete(active,'STAFF_ACCESS'); }} onSkip={() => complete(active,'STAFF_ACCESS')} />;
+      case 'STAFF_ACCESS': return <StaffSetup onCreate={(data) => runtime.command('staff.create',data)} staff={runtime.status?.staff || []} onComplete={() => complete(active,'TILL')} />;
+      case 'TILL': return <TillPolicyStep existing={recordsOf(snapshot,'tillPolicy')[0]} onSave={async data => { await save('tillPolicy','main',{ name:'Till policy', ...data }); await complete(active,'BACKUP_SYNC'); }} />;
+      case 'BACKUP_SYNC': return <BackupSetup onBackup={runtime.backup} onSync={runtime.sync} onComplete={() => complete(active)} />;
+      default: return null;
+    }
+  })();
+  return <div className="min-h-screen bg-slate-950 text-slate-100"><header className="border-b border-slate-800 bg-slate-900 px-5 py-4"><div className="mx-auto flex max-w-7xl items-center justify-between gap-4"><div><div className="text-xs font-bold tracking-[.2em] text-amber-400">BUSINESS SETUP</div><h1 className="text-xl font-black">Configure the real bar before trading</h1></div><button className={buttonClass} onClick={() => void runtime.lock()}>Lock terminal</button></div></header>
+    <div className="mx-auto grid max-w-7xl gap-6 p-5 lg:grid-cols-[320px_1fr]"><aside className="space-y-3"><div className="rounded-2xl border border-slate-800 bg-slate-900 p-4"><div className="flex justify-between text-sm"><span>Required setup</span><strong>{percent}%</strong></div><div className="mt-2 h-2 rounded-full bg-slate-800"><div className="h-2 rounded-full bg-amber-400" style={{width:`${percent}%`}} /></div></div>{steps.map(([id,label,requiredStep]) => <button key={id} onClick={() => setActive(id)} className={`w-full rounded-xl border p-3 text-left ${active===id?'border-amber-400 bg-amber-500/10':'border-slate-800 bg-slate-900'}`}><div className="flex items-center justify-between"><span className="font-semibold">{label}</span><span className={done.includes(id)?'text-emerald-400':'text-slate-600'}>{done.includes(id)?'✓':'○'}</span></div><span className="text-xs text-slate-500">{requiredStep?'Required':'Optional'}</span></button>)}</aside>
+      <main className="space-y-4">{message && <p className="rounded-xl border border-emerald-900 bg-emerald-950/50 p-3 text-sm text-emerald-300">{message}</p>}{runtime.error && <p className="rounded-xl bg-rose-950 p-3 text-sm text-rose-200">{runtime.error}</p>}{content}<section className="rounded-2xl border border-amber-500/20 bg-amber-500/5 p-5"><h2 className="font-bold">Go-live readiness</h2><p className="mt-2 text-sm text-slate-400">{ready || snapshot.installationStage==='READY_FOR_GO_LIVE' ? 'Required configuration is complete. Confirm that it represents the real business before activating live trading.' : 'Complete every required setup step. Optional steps can be finished later.'}</p><button className={`${primaryButtonClass} mt-4`} disabled={!ready && snapshot.installationStage!=='READY_FOR_GO_LIVE'} onClick={() => void runtime.command('setup.goLive').then(() => setMessage('ServOS is LIVE.'))}>Approve Go Live</button></section></main>
+    </div></div>;
+};
+
