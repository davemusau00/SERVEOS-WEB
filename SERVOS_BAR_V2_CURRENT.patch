+fn parse_clock(value: &str) -> Option<i32> {
+    let mut parts=value.split(':');
+    let h=parts.next()?.parse::<i32>().ok()?; let m=parts.next()?.parse::<i32>().ok()?;
+    if !(0..24).contains(&h) || !(0..60).contains(&m) { return None; }
+    Some(h*60+m)
+}
