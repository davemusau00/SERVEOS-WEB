+import React, { useMemo, useState } from 'react';
+import { Search } from 'lucide-react';
+import help from '../generated/help-index.json';
+import { fieldClass } from './records';
+
+type Article={id:string;title:string;section:string;roles:string[];permissions:string[];screen:string;summary:string;body:string;keywords:string[]};
+export function HelpCenterView({initialQuery=''}:{initialQuery?:string}){const articles=help.articles as Article[];const [query,setQuery]=useState(initialQuery);const [selected,setSelected]=useState(articles.find(a=>a.id.includes(initialQuery))||articles[0]);const results=useMemo(()=>{const q=query.toLowerCase().trim();return !q?articles:articles.filter(a=>[a.title,a.section,a.summary,a.body,...a.keywords,...a.permissions].join(' ').toLowerCase().includes(q))},[query,articles]);return <div className="grid h-full min-h-0 grid-cols-1 bg-slate-950 text-white lg:grid-cols-[360px_1fr]"><aside className="min-h-0 overflow-auto border-r border-slate-800 p-4"><h1 className="text-xl font-bold">ServOS Help Center</h1><p className="mb-4 text-xs text-slate-400">Offline guide generated from docs/user-guide.</p><div className="relative"><Search className="absolute left-3 top-3 h-4 w-4 text-slate-500"/><input className={fieldClass+' pl-9'} value={query} onChange={e=>setQuery(e.target.value)} placeholder="Search refund, M-Pesa, stock count…"/></div><div className="mt-4 space-y-2">{results.map(a=><button key={a.id} onClick={()=>setSelected(a)} className={`w-full rounded-xl border p-3 text-left ${selected?.id===a.id?'border-amber-500 bg-amber-500/10':'border-slate-800 bg-slate-900'}`}><div className="text-xs text-slate-500">{a.section}</div><b>{a.title}</b></button>)}</div></aside><main className="min-h-0 overflow-auto p-6">{selected&&<><div className="text-xs font-mono text-amber-400">{selected.section} · {selected.screen||'General'}</div><h2 className="mt-1 text-3xl font-bold">{selected.title}</h2><p className="mt-3 max-w-3xl text-slate-400">{selected.summary}</p><div className="mt-4 flex flex-wrap gap-2">{selected.roles.map(x=><span key={x} className="rounded bg-slate-800 px-2 py-1 text-xs">{x}</span>)}{selected.permissions.map(x=><span key={x} className="rounded bg-purple-500/10 px-2 py-1 text-xs text-purple-300">{x}</span>)}</div><article className="prose prose-invert mt-7 max-w-4xl whitespace-pre-wrap text-sm leading-7 text-slate-200">{selected.body}</article></>}</main></div>}
