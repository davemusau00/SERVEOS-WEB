+export function NativeFloorplanView(){const runtime=useRuntime();const s=runtime.snapshot!;const canManage=s.actor.permissions.includes('floorplan.manage');const outlets=recordsOf(s,'outlets');const allTables=recordsOf(s,'tables');const [outletId,setOutletId]=useState(outlets[0]?.id||'');const existing=allTables.filter(t=>t.outletId===outletId);const [draft,setDraft]=useState<any[]>(existing);const [message,setMessage]=useState('');React.useEffect(()=>setDraft(allTables.filter(t=>t.outletId===outletId).map(t=>({...t}))),[outletId,s.records.length]);const baseline=s.records.filter(r=>r.collection==='tables'&&!r.archived&&r.data.outletId===outletId).map(r=>({id:r.id,version:r.version}));return <div className="h-full overflow-auto bg-slate-950 p-5 text-white"><div className="mb-5 flex flex-wrap items-center justify-between gap-3"><div><h1 className="text-2xl font-bold">Floor plan</h1><p className="text-sm text-slate-400">One atomic native layout save preserves occupied table state.</p></div><select className={fieldClass+' max-w-xs'} value={outletId} onChange={e=>setOutletId(e.target.value)}>{outlets.map(o=><option key={o.id} value={o.id}>{o.name}</option>)}</select></div><div className="grid gap-3 md:grid-cols-2 xl:grid-cols-3">{draft.map((t,i)=><div key={t.id} className="rounded-xl border border-slate-800 bg-slate-900 p-3"><div className="grid grid-cols-2 gap-2"><label>Label<input disabled={!canManage} className={fieldClass} value={t.label} onChange={e=>setDraft(d=>d.map((x,j)=>j===i?{...x,label:e.target.value}:x))}/></label><label>Capacity<input disabled={!canManage} className={fieldClass} type="number" min="1" value={t.capacity} onChange={e=>setDraft(d=>d.map((x,j)=>j===i?{...x,capacity:Number(e.target.value)}:x))}/></label><label>Section<input disabled={!canManage} className={fieldClass} value={t.section||'Main'} onChange={e=>setDraft(d=>d.map((x,j)=>j===i?{...x,section:e.target.value}:x))}/></label><label>Minimum spend<input disabled={!canManage} className={fieldClass} type="number" min="0" value={t.minimumSpend||t.minimumSpendKes||0} onChange={e=>setDraft(d=>d.map((x,j)=>j===i?{...x,minimumSpend:Number(e.target.value)}:x))}/></label></div><div className="mt-2 text-xs text-slate-500">State: {t.state||'AVAILABLE'} {t.currentOrderId?'· occupied':''}</div><button className={buttonClass+' mt-2'} disabled={!canManage||!!t.currentOrderId} onClick={()=>setDraft(d=>d.filter(x=>x.id!==t.id))}>Remove</button></div>)}</div><div className="mt-4 flex gap-2"><button disabled={!canManage} className={buttonClass} onClick={()=>setDraft(d=>[...d,{id:crypto.randomUUID(),propertyId:'property',outletId,label:String(d.length+1),capacity:4,section:'Main',state:'AVAILABLE',shape:'SQUARE',posX:10+(d.length%4)*20,posY:10+Math.floor(d.length/4)*20,minimumSpend:0,isJoinable:true}])}>Add table</button><button disabled={!canManage} className={primaryButtonClass} onClick={()=>void runtime.command('floorplan.save',{outletId,baseline,tables:draft}).then(()=>setMessage('Layout saved locally.')).catch(e=>setMessage(String(e)))}>Save layout</button></div>{message&&<p className="mt-3 text-sm text-slate-300">{message}</p>}</div>}
